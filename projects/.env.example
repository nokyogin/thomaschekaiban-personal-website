# Google OAuth credentials — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Comma-separated list of Google email addresses allowed to sign in
ALLOWED_EMAILS=thomas@example.com

# Vercel Postgres — automatically set when you link a Vercel Postgres database
# via: vercel link → vercel env pull
POSTGRES_URL=
